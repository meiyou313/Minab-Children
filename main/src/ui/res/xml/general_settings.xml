<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">
    <PreferenceCategory
            android:key="app_behaviour"
            android:title="@string/appbehaviour">
        <!-- Minab Beta v0.7: show-speed-in-notification moved to the
             TOP of the settings list. Default on (XML defaultValue
             and the code default in OpenVPNService both true). -->
        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="true"
                android:key="minab_show_speed_notification"
                android:singleLineTitle="false"
                android:summary="@string/minab_show_speed_notification_summary"
                android:title="@string/minab_show_speed_notification" />

        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="true"
                android:key="showlogwindow"
                android:singleLineTitle="false"
                android:summary="@string/show_log_summary"
                android:title="@string/show_log_window" />

        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="false"
                android:disableDependentsState="true"
                android:key="ovpn3"
                android:singleLineTitle="false"
                android:summaryOff="Use OpenVPN 2.x"
                android:summaryOn="Use the C++ OpenVPN library (experimental)"
                android:title="OpenVPN 3 Core" />


        <de.blinkt.openvpn.views.DefaultVPNListPreference app:iconSpaceReserved="false"
                android:key="alwaysOnVpn"
                android:singleLineTitle="false"
                android:title="@string/defaultvpn"
                tools:summary="@string/defaultvpnsummary" />

        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="false"
                android:key="restartvpnonboot"
                android:singleLineTitle="false"
                android:summary="@string/keep_vpn_connected_summary"
                android:title="@string/keep_vpn_connected" />

        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="true"
                android:key="preferencryption"
                android:singleLineTitle="false"
                android:summary="@string/encrypt_profiles_summary"
                android:title="@string/encrypt_profiles" />

        <!-- Minab Beta v0.9: auto-failover — switch to the next
             healthy server when the connected one drops (up to 3
             tries). Default on. -->
        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="true"
                android:key="minab_failover"
                android:singleLineTitle="false"
                android:summary="@string/minab_failover_summary"
                android:title="@string/minab_failover" />

        <!-- Minab Beta v0.9: per-app VPN (split tunneling) picker. -->
        <Preference app:iconSpaceReserved="false"
                android:key="minab_per_app_vpn"
                android:persistent="false"
                android:singleLineTitle="false"
                android:summary="@string/minab_per_app_vpn_summary"
                android:title="@string/minab_per_app_vpn" />

        <!-- Minab Beta v0.4: manual update check (Home and About
             check automatically, cached for 24 h). -->
        <Preference app:iconSpaceReserved="false"
                android:key="minab_check_update"
                android:persistent="false"
                android:singleLineTitle="false"
                android:summary="@string/minab_check_update_summary"
                android:title="@string/minab_check_update" />

        <CheckBoxPreference app:iconSpaceReserved="false" android:key="local_network"
                android:persistent="false"
                android:singleLineTitle="false"
                android:title="@string/local_network_permission"
                android:summary="@string/local_network_permission_summary"
                />

        <Preference app:iconSpaceReserved="false"
                android:key="clearapi"
                android:persistent="false"
                android:singleLineTitle="false"
                android:title="@string/clear_external_apps" />


    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vpnbehaviour">
        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="true"
                android:dependency="ovpn3"
                android:key="usesystemproxy"
                android:singleLineTitle="false"
                android:summary="@string/use_system_proxy_summary"
                android:title="@string/use_system_proxy" />
        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="true"
                android:key="netchangereconnect"
                android:singleLineTitle="false"
                android:summary="@string/netchange_summary"
                android:title="@string/netchange" />


        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="false"
                android:key="screenoff"
                android:singleLineTitle="false"
                android:summary="@string/screenoff_summary"
                android:title="@string/screenoff_title" />

        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="false"
                android:key="disableconfirmation"
                android:singleLineTitle="false"
                android:summary="@string/confirmations_summary"
                android:title="@string/confirmations_title" />\

        <Preference app:iconSpaceReserved="false"
                android:dependency=""
                android:key="osslspeed"
                android:persistent="false"
                android:title="@string/osslspeedtest" />

    </PreferenceCategory>

    <PreferenceCategory
            android:key="device_hacks"
            android:title="@string/device_specific">
        <CheckBoxPreference app:iconSpaceReserved="false"
                android:defaultValue="false"
                android:key="useInternalFileSelector"
                android:summary="Always use the very basic file browser instead of the Android file browser. Use this option if you have problems selecting files."
                android:title="Use internal file browser" />
    </PreferenceCategory>

    <!-- Minab Beta v0.5 — FAQ moved out of the bottom tab bar and
         to the end of Settings. Tapping it opens the FAQ full-screen
         (see GeneralSettings.onPreferenceClick). -->
    <Preference app:iconSpaceReserved="false"
            android:key="minab_faq"
            android:persistent="false"
            android:summary="@string/minab_faq_settings_summary"
            android:title="@string/faq" />

</PreferenceScreen>
