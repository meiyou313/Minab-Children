<?xml version="1.0" encoding="utf-8"?><!--
  ~ Minab Beta v0.4 — the CONFIGS tab: a dedicated place to manage
  ~ configs. Group filter tabs on top, action buttons (credentials
  ~ for this group / for all, backup), then the config list. Tap a
  ~ config for rename, credentials, category, ping or delete.
  ~
  ~ Minab Beta v0.5 — minimal and self-explanatory: the credentials
  ~ buttons sit under a "VPN username & password" heading with an
  ~ explanation of what they do; the rows are minimal (checkbox,
  ~ flag, small name) like Home; ticking boxes reveals Delete
  ~ selected / Share as zip; the group bar fades at the right edge.
  ~
  ~ Minab Beta v0.9 — the server list is part of this page's single
  ~ scroll now, like Home (one NestedScrollView; the ListView is
  ~ sized to its content in code, ConfigsFragment.expandListView),
  ~ so the list no longer sits in a separate small window with its
  ~ own scroll. The selection buttons use short one-word labels
  ~ ("Delete", "Copy", "Move", "Share") and wrap_content height, so
  ~ they can never wrap to a clipped second line (v0.8 screenshot:
  ~ "Delete selected" wrapped and its second line was cut off).
  -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_configs_title"
        android:textColor="@color/minab_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_configs_hint"
        android:textColor="@color/minab_text_secondary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/minab_configs_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/minab_configs_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Minab Beta v0.5 — the credentials section, with a plain
         explanation: these buttons set the VPN username/password
         the configs use to log in. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_credentials_title"
        android:textColor="@color/minab_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_credentials_explained"
        android:textColor="@color/minab_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_configs_credentials_group"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/minab_credentials_for_group"
            android:textSize="12sp" />

        <Button
            android:id="@+id/minab_configs_credentials_all"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/minab_credentials_for_all"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_configs_backup"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/minab_backup_configs"
            android:textSize="12sp" />

        <Button
            android:id="@+id/minab_configs_share"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/minab_share_zip"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Minab Beta v0.6 — the two server tests, so the user can
         choose: Ping test is fast but only checks the server
         answers; Real test actually connects each server and opens
         Telegram Web through it, so it proves the server really
         bypasses filtering (and waits up to 20 s per server). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_configs_test_title"
        android:textColor="@color/minab_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_configs_test_explained"
        android:textColor="@color/minab_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_configs_test_ping"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/minab_test_ping"
            android:textSize="12sp" />

        <Button
            android:id="@+id/minab_configs_test_real"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/minab_real_test"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Minab Beta v0.6 — test progress (either test): bar +
         status line + Cancel. Mirrors Home's progress row. -->
    <LinearLayout
        android:id="@+id/minab_configs_test_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/minab_configs_test_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/minab_divider"
            android:progressTint="@color/minab_teal" />

        <TextView
            android:id="@+id/minab_configs_test_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <Button
            android:id="@+id/minab_configs_test_cancel_btn"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="@string/minab_cancel_short"
            android:textAllCaps="false"
            android:textColor="@color/minab_teal" />
    </LinearLayout>

    <!-- Minab Beta v0.5 — selection actions: shown only while one
         or more configs are ticked. Minab Beta v0.8: Copy and Move
         sit next to Delete, to copy or move the ticked configs to
         another group. Minab Beta v0.9: one-word labels and
         wrap_content height (see the header comment) — the old
         "Delete selected" label wrapped to two lines in a 36dp
         button and its second line was clipped. -->
    <LinearLayout
        android:id="@+id/minab_configs_selection_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/minab_configs_delete_selected"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:singleLine="true"
            android:text="@string/minab_delete_short"
            android:textColor="@color/minab_busy"
            android:textSize="11sp" />

        <Button
            android:id="@+id/minab_configs_copy_selected"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:singleLine="true"
            android:text="@string/minab_copy_selected"
            android:textSize="11sp" />

        <Button
            android:id="@+id/minab_configs_move_selected"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:singleLine="true"
            android:text="@string/minab_move_selected"
            android:textSize="11sp" />

        <Button
            android:id="@+id/minab_configs_share_selected"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:singleLine="true"
            android:text="@string/minab_share_zip"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Minab Beta v0.9 — the list is part of this page's single
         scroll (see the header comment): no inner scroll, its
         height is set to its content in code. -->
    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/minab_card_bg"
        android:divider="@color/minab_divider"
        android:dividerHeight="1dp"
        android:nestedScrollingEnabled="false" />

    <TextView
        android:id="@android:id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:text="@string/minab_no_profiles_yet"
        android:textColor="@color/minab_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>
