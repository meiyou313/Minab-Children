<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/stdpadding"
        android:paddingRight="@dimen/stdpadding"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Minab Beta v0.9 — check for updates, at the TOP of the
             About screen (like Namaki). Tapping it checks GitHub
             now (no 24 h cache) and the result shows in
             minab_update_status directly under the button. -->
        <Button
            android:id="@+id/minab_about_check_update"
            style="@style/Minab.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:text="@string/minab_check_update"
            android:textSize="13sp" />

        <!-- Minab Beta v0.9.1 — the check result, RIGHT UNDER the
             button (fix #1): it used to sit below the whole About
             text, so the user had to scroll to find it. -->
        <TextView
                android:id="@+id/minab_update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/minab_banner_bg"
                android:backgroundTint="@color/minab_teal_tint"
                android:fontFamily="@font/vazirmatn"
                android:padding="10dp"
                android:textColor="@color/minab_teal_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?android:attr/textAppearanceLarge"
                tools:ignore="SelectableText"
                tools:text="OpenVPN for Android 1.2.3" />

        <!-- Minab Beta v0.4 — what Minab is, in Minab's own words.
             Minab Beta v0.8 — autoLink="web" so the GitHub links
             in minab_about_text are tappable.
             Minab Beta v0.9 — the text is set in code
             (AboutFragment) so the version appears in it. -->
        <TextView
                android:id="@+id/minab_about_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autoLink="web"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/minab_text_secondary"
                android:textSize="13sp" />
    </LinearLayout>

</ScrollView>
