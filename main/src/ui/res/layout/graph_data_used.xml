<?xml version="1.0" encoding="utf-8"?><!--
  ~ Minab Beta v0.7 — "Data used" header for the Graph tab.
  ~ A card with three toggleable bar-chart views (daily / weekly /
  ~ monthly) of the real measured download + upload, then a
  ~ "Live speed" heading above the existing live line charts.
  ~ The bars are built in code (GraphFragment.renderDataUsed) from
  ~ plain Views — no chart library — inside minab_data_bars.
  ~
  ~ Minab Beta v0.8 — the Daily / Weekly / Monthly chips looked
  ~ half-cut on the phone: a stock Button is 48dp tall by default
  ~ with font padding, so at 32dp the 12sp Vazirmatn text was
  ~ clipped top and bottom. The chips are now 36dp with no minimum
  ~ height, no padding and no font padding, so the text sits
  ~ centred and whole; the background is set here too (the code
  ~ in updateDataChips still swaps it for the active one).
  -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/minab_card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_data_used"
            android:textColor="@color/minab_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minab_data_daily"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_daily"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/minab_data_weekly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_weekly"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/minab_data_monthly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_monthly"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/minab_data_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_data_none_yet"
            android:textColor="@color/minab_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/minab_data_bars"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/minab_data_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_live_speed"
        android:textColor="@color/minab_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
