  ~ Minab Beta v0.3 — Namaki-style home, rebuilt natively in XML.
  ~ Modelled on Namaki's Flutter overview page (not copied: Minab is
  ~ native Android, so the look is rebuilt with drawables and views):
  ~ gradient background (#E9EEFF -> #F9FAFF, night: Midnight
  ~ #141B3D -> #070A18), a large circular connect button with three
  ~ concentric rings (glow 250dp, ring 186dp, disc 148dp — the
  ~ PowerOrb), the state under it, then the visible action buttons,
  ~ category chips, ping progress, and the server list as ONE
  ~ grouped card (shadowless, 16dp corners, thin border, rows
  ~ separated by divider lines) with a coloured ping pill per row.
  ~ Bulk import, Test ping, category chips and ping badges all stay
  ~ visible on this screen — nothing lives only in the overflow menu.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/notification_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/stdpadding"
            android:drawableStart="@drawable/notifications"
            android:drawablePadding="@dimen/stdpadding"
            tools:visibility="visible"
            android:visibility="gone"
            android:text="@string/missing_notification_permission" />

        <!-- Namaki-style header: app name + subtitle, like the
             overview page's top row (logo + title). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/app"
                android:textColor="@color/minab_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_app_subtitle"
                android:textColor="@color/minab_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Namaki PowerOrb: glow (250dp) + ring (186dp) + disc
             (148dp). Tapping the disc connects the selected / last
             used profile, or disconnects while connected. -->
        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <View
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/minab_orb_glow" />

            <View
                android:layout_width="186dp"
                android:layout_height="186dp"
                android:layout_gravity="center"
                android:background="@drawable/minab_orb_ring" />

            <ImageButton
                android:id="@+id/minab_power_orb"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center"
                android:background="@drawable/minab_orb_disc"
                android:contentDescription="@string/minab_tap_to_connect"
                android:scaleType="center"
                android:src="@drawable/ic_minab_power" />
        </FrameLayout>

        <TextView
            android:id="@+id/minab_home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:text="@string/minab_tap_to_connect"
            android:textColor="@color/minab_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:text="@string/minab_tap_to_connect_hint"
            android:textColor="@color/minab_text_secondary"
            android:textSize="13sp" />

        <!-- Minab Children: visible action buttons (v0.2). In v0.1 these
             were text-only items in the overflow menu, so users could
             not find them. The overflow items are kept as well. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minab_btn_bulk_import"
                style="@style/Minab.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_minab_import"
                android:drawableTint="@android:color/white"
                android:text="@string/minab_bulk_import_short" />

            <Button
                android:id="@+id/minab_btn_ping"
                style="@style/Minab.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_minab_ping"
                android:drawableTint="@color/minab_teal"
                android:text="@string/minab_test_ping" />
        </LinearLayout>

        <!-- Minab Children: category chips (v0.2). Replaces the single
             small "All categories" text line of v0.1. Chips are built
             in code (VPNProfileList.rebuildCategoryChips): All + one
             chip per category + a Manage chip. -->
        <HorizontalScrollView
            android:id="@+id/minab_category_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/minab_category_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Minab Children: ping progress (v0.2). Visible while a ping
             test runs: bar + "Pinging N profiles… X done" + Cancel.
             After a finished test it shows "Sorted by ping (fastest
             first)" with a full bar until the next test. -->
        <LinearLayout
            android:id="@+id/minab_ping_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/minab_ping_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/minab_divider"
                android:progressTint="@color/minab_teal" />

            <TextView
                android:id="@+id/minab_ping_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/minab_text_secondary" />

            <Button
                android:id="@+id/minab_ping_cancel_btn"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/minab_cancel_short"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal" />
        </LinearLayout>

        <!-- Namaki servers page: the server list is ONE grouped card
             (shadowless, 16dp corners, thin border) with rows
             separated by divider lines. The ListView itself carries
             the card background; its divider is the row separator. -->
        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/minab_card_bg"
            android:descendantFocusability="afterDescendants"
            android:divider="@color/minab_divider"
            android:dividerHeight="1dp" />

        <LinearLayout
            android:id="@android:id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_vpn_profiles_defined"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12sp" />


            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="@string/openvpn_is_no_free_vpn" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12sp" />


            <TextView
                android:id="@+id/add_new_vpn_hint"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                tools:ignore="SelectableText" />

            <TextView
                android:id="@+id/import_vpn_hint"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                tools:ignore="SelectableText" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12sp" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/faq_hint" />
        </LinearLayout>

    </LinearLayout>

    <!-- <include layout="@layout/profile_list_fabs" /> -->

</FrameLayout>
