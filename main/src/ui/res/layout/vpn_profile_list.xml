  ~ Minab Beta v0.3 — Namaki-style home, rebuilt natively in XML.
  ~ Modelled on Namaki's Flutter overview page (not copied: Minab is
  ~ native Android, so the look is rebuilt with drawables and views):
  ~ gradient background (#E9EEFF -> #F9FAFF, night: Midnight
  ~ #141B3D -> #070A18), a circular connect button with three
  ~ concentric rings (glow 200dp, ring 149dp, disc 118dp — the
  ~ PowerOrb, shrunk ~20% in v0.4), the state under it, then the
  ~ visible action buttons, group tabs (no per-group ping icon
  ~ since v0.8 — Ping test / Real test now test the selected
  ~ group), ping progress, and the server list as ONE grouped card (shadowless, 16dp corners, thin border, rows
  ~ separated by divider lines) with a coloured ping pill per row.
  ~ Bulk import, Ping test, category chips and ping badges all stay
  ~ visible on this screen — nothing lives only in the overflow menu.
  ~
  ~ Minab Beta v0.5 — the header subtitle ("Bulk import · Groups ·
  ~ Bulk ping") is gone; next to the Minab title sits the memorial
  ~ line in very small type. The action buttons and group tabs are
  ~ smaller and more minimal; the group bar fades at the right edge
  ~ so it is clear it scrolls. The config list is merged into this
  ~ page's own scroll (one NestedScrollView; the ListView is sized
  ~ to its content in code, VPNProfileList.expandListView), so the
  ~ list no longer looks like a separate window.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp">

        <!-- Minab Beta v0.4 — minimal one-line notification banner.
             v0.3 showed the long stock text here and it filled half
             the screen. Now the permission is requested at first
             launch; only if the user declines does this small box
             appear (one line, tap to re-request or open settings). -->
        <TextView
            android:id="@+id/notification_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_banner_bg"
            android:drawableStart="@drawable/notifications"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn"
            android:maxLines="1"
            android:padding="8dp"
            android:singleLine="true"
            android:text="@string/minab_notification_off"
            android:textColor="@color/minab_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Minab Beta v0.4 — update notice. Hidden until the
             update check finds a newer release on GitHub; tap opens
             the releases page. -->
        <TextView
            android:id="@+id/minab_update_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/minab_banner_bg"
            android:backgroundTint="@color/minab_teal_tint"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn"
            android:maxLines="1"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/minab_teal_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Minab Beta v0.5 — header: app name, and the memorial
             line in very small type right next to it.
             Minab Beta v0.8: the app icon sits to the left of the
             app name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/app"
                android:src="@drawable/ic_logo_bunt" />

            <!-- Minab Beta v0.7: the app name is now "Minab Open
                 Vpn", so the title is 20sp (was 22sp) to leave
                 room for the memorial line beside it. v0.8: the
                 name is "Minab OpenVPN" and the icon sits to its
                 left. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/app"
                android:textColor="@color/minab_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="2"
                android:text="@string/minab_memorial"
                android:textColor="@color/minab_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Namaki PowerOrb: glow + ring + disc. v0.7: ~30% smaller
             than v0.6 (200/149/118dp -> 140/104/83dp), still
             centred and tappable. v0.4 had shrunk it ~20% from
             v0.3 (250/186/148) for the same reason. Tapping the
             disc connects the selected / last used profile, or
             disconnects while connected. -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/minab_orb_glow" />

            <View
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/minab_orb_ring" />

            <ImageButton
                android:id="@+id/minab_power_orb"
                android:layout_width="83dp"
                android:layout_height="83dp"
                android:layout_gravity="center"
                android:background="@drawable/minab_orb_disc"
                android:contentDescription="@string/minab_tap_to_connect"
                android:scaleType="center"
                android:src="@drawable/ic_minab_power" />
        </FrameLayout>

        <!-- Minab Beta v0.7: the status line is small and minimal
             when connected ("Connected — <name>", 12sp, one line)
             and next to it the connected server's ping as a
             tappable pill — tap re-tests the ping of that server
             only. When not connected the title stays big. -->
        <LinearLayout
            android:id="@+id/minab_home_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minab_home_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="1"
                android:maxWidth="240dp"
                android:singleLine="true"
                android:text="@string/minab_tap_to_connect"
                android:textColor="@color/minab_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minab_connected_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/minab_chip_bg"
                android:clickable="true"
                android:contentDescription="@string/minab_connected_ping_desc"
                android:focusable="true"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/minab_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="94 ms" />
        </LinearLayout>

        <!-- Minab Children: visible action buttons (v0.2). In v0.1 these
             were text-only items in the overflow menu, so users could
             not find them. The overflow items are kept as well.
             v0.5: 36dp high, 12sp text, 18dp icons — much smaller and
             more minimal than the 48dp v0.4 buttons.
             v0.7: 11sp, single line, tighter padding, and "Import"
             instead of "Bulk import" — the three labels used to wrap
             and get clipped on narrow screens. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minab_btn_bulk_import"
                style="@style/Minab.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_minab_import_small"
                android:drawablePadding="4dp"
                android:drawableTint="@android:color/white"
                android:ellipsize="end"
                android:minHeight="36dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:text="@string/minab_import_short"
                android:textSize="11sp" />

            <Button
                android:id="@+id/minab_btn_ping"
                style="@style/Minab.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_minab_ping_small"
                android:drawablePadding="4dp"
                android:drawableTint="@color/minab_teal"
                android:ellipsize="end"
                android:minHeight="36dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:text="@string/minab_test_ping"
                android:textSize="11sp" />

            <!-- Minab Beta v0.6: Real test — connect each server in
                 turn and fetch web.telegram.org through the tunnel,
                 so the result proves the server really bypasses
                 filtering (a plain ping cannot prove that). -->
            <Button
                android:id="@+id/minab_btn_real_test"
                style="@style/Minab.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_minab_ping_small"
                android:drawablePadding="4dp"
                android:drawableTint="@color/minab_teal"
                android:ellipsize="end"
                android:minHeight="36dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:text="@string/minab_real_test"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Minab Beta v0.6 — what the two tests mean, so the user
             knows the ping test is fast but the real test is the
             accurate one. v0.8: Ping test / Real test test only the
             selected group (or everything when "all" is selected). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_tests_explained"
            android:textColor="@color/minab_text_secondary"
            android:textSize="11sp" />

        <!-- Minab Children: group tabs (v0.4). One tab per group
             (country groups are assigned automatically on import by
             AutoCategory; the user can also create groups by hand).
             Tapping a tab filters the list; Ping test / Real test
             test the selected group (v0.8 — the per-group ping icon
             is gone). Built in code (VPNProfileList.rebuildCategoryChips):
             all + one tab per group + Manage + a "+" tab at the end.
             v0.5: the bar fades at the right edge (fadingEdge) and the
             last tab peeks in, so it is clear the bar scrolls right. -->
        <HorizontalScrollView
            android:id="@+id/minab_category_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/minab_category_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Minab Children: ping progress (v0.2). Visible while a ping
             test runs: bar + "Pinging N profiles… X done" + Cancel.
             After a finished test it shows "Sorted by ping (fastest
             first)" with a full bar until the next test. -->
        <LinearLayout
            android:id="@+id/minab_ping_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/minab_ping_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/minab_divider"
                android:progressTint="@color/minab_teal" />

            <TextView
                android:id="@+id/minab_ping_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/minab_text_secondary" />

            <Button
                android:id="@+id/minab_ping_cancel_btn"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/minab_cancel_short"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal" />
        </LinearLayout>

        <!-- Namaki servers page: the server list is ONE grouped card
             (shadowless, 16dp corners, thin border) with rows
             separated by divider lines. The ListView itself carries
             the card background; its divider is the row separator.
             v0.5: the list is part of this page's single scroll —
             the ListView does not scroll on its own (its height is
             set to its content in code) and the rows are minimal. -->
        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/minab_card_bg"
            android:descendantFocusability="afterDescendants"
            android:divider="@color/minab_divider"
            android:dividerHeight="1dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:id="@android:id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_vpn_profiles_defined"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12sp" />


            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="@string/openvpn_is_no_free_vpn" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12sp" />


            <TextView
                android:id="@+id/add_new_vpn_hint"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                tools:ignore="SelectableText" />

            <TextView
                android:id="@+id/import_vpn_hint"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                tools:ignore="SelectableText" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12sp" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/faq_hint" />
        </LinearLayout>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- <include layout="@layout/profile_list_fabs" /> -->

</FrameLayout>
