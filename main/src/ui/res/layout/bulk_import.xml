<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Minab Children — addition on top of ics-openvpn (GPLv2).
  ~ Bulk import screen: pick many .ovpn files or one .zip, one shared
  ~ username/password for all, a category for the batch, and an
  ~ opt-in auto-detect-country checkbox.
  ~
  ~ Minab Beta v0.3 — Namaki-style card (shadowless, 16dp corners,
  ~ thin border) on the home gradient, indigo primary button.
  ~ v0.3 fixes: (1) live import progress — a progress bar plus
  ~ "Imported X of N…" instead of one static "Importing…" line, and
  ~ the last import summary is stored and shown again when the user
  ~ comes back (minab_bulk_last_summary); (2) a real Apply button
  ~ for the shared username/password (minab_bulk_apply_credentials).
  ~ All view ids from v0.2 are kept, so BulkImportActivity only adds
  ~ the new ones.
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/minab_card_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_bulk_import_hint"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <Button
            android:id="@+id/minab_bulk_pick"
            style="@style/Minab.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_minab_import"
            android:drawableTint="@android:color/white"
            android:text="@string/minab_pick_files" />

        <Button
            android:id="@+id/minab_bulk_pick_zip"
            style="@style/Minab.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_baseline_archive_24"
            android:drawableTint="@color/minab_teal"
            android:text="@string/minab_pick_zip" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_shared_credentials_hint"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/minab_username"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <EditText
            android:id="@+id/minab_bulk_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/minab_input_bg"
            android:fontFamily="@font/vazirmatn"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/minab_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/minab_password"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <EditText
            android:id="@+id/minab_bulk_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/minab_input_bg"
            android:fontFamily="@font/vazirmatn"
            android:hint="@string/pw_query_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/minab_text_primary" />

        <!-- v0.3 bug fix 2: a real Apply button. The old "apply to
             all" checkbox only affected the batch being imported and
             had no confirmation; Apply saves the credentials and
             writes them into ALL profiles that need a
             username/password — already imported and future ones. -->
        <Button
            android:id="@+id/minab_bulk_apply_credentials"
            style="@style/Minab.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/minab_apply_credentials" />

        <CheckBox
            android:id="@+id/minab_bulk_apply_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/minab_apply_to_all"
            android:textColor="@color/minab_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/minab_import_category"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <Spinner
            android:id="@+id/minab_bulk_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/minab_bulk_auto_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/minab_auto_category"
            android:textColor="@color/minab_text_primary" />

        <!-- v0.3 bug fix 1: live progress bar + "Imported X of N…"
             while an import runs (was one static "Importing…" line). -->
        <ProgressBar
            android:id="@+id/minab_bulk_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/minab_divider"
            android:progressTint="@color/minab_teal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/minab_bulk_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

        <!-- v0.3 bug fix 1: the last import summary, stored in
             SharedPreferences and shown again on return (was only a
             transient Toast, lost when leaving the page). -->
        <TextView
            android:id="@+id/minab_bulk_last_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/minab_text_secondary" />

    </LinearLayout>
</ScrollView>
