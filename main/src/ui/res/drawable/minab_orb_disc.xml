<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Minab Beta v0.3 — PowerOrb disc, disconnected state (Namaki
  ~ overview page: gradient disc, white 40%-alpha edge). The
  ~ connected state is minab_orb_disc_connected.xml (green).
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:endColor="@color/minab_indigo"
        android:startColor="@color/minab_indigo_light"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="@color/minab_orb_disc_edge" />
</shape>
